{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-on-edit.mjs\"",
            "timeout": 120,
            "statusMessage": "Formatting, linting, type-checking and testing the edited file..."
          }
        ]
      }
    ]
  }
}
