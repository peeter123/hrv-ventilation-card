# Copy to .env (git-ignored) and fill in. Used by the scripts that drive a live Home Assistant in a browser
# (live checks and the visual editor screenshot); the cards and tests do not need it.

# Base URL of the Home Assistant frontend, without a trailing slash.
HA_URL=https://homeassistant.example.com

# Long-lived access token of an admin user (Profile > Security > Long-lived access tokens).
# Admin is needed to open the dashboard editor. Revoke the token when you no longer need it.
HA_TOKEN=
